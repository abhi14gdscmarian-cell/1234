{
    "uart": {
        "port": "COM5",
        "baudrate": 115200,
        "bytesize": 8,
        "parity": "N",
        "stopbits": 1
    },
    "flash": {
        "_comment": "Set FP_EXPRESS_EXE, OPENOCD_EXE, OPENOCD_SCRIPTS and DEVICE in the Jenkins node environment. Placeholders are expanded by flash_controller.py.",
        "rtl_command": "\"{fpexpress}\" SCRIPT:\"{tcl_script}\" SCRIPT_ARGS:\"{rtl_job}\" logfile:\"{flash_log}\"",
        "rtl_success_regex": "FLASHPRO_PROGRAMMING_COMPLETED",
        "rtl_timeout_s": 1200,
        "elf_command": "\"{openocd}\" -s \"{openocd_scripts}\" -c \"set DEVICE {device}\" -f \"automation/tools/board.cfg\" -c \"program {elf} verify reset exit\"",
        "elf_success_regex": "Verified OK|verified",
        "elf_timeout_s": 900,
        "retries": 0,
        "settle_after_flash_s": 5
    },
    "clean_paths": [
        "automation/work/*"
    ],
    "continue_on_failure": false,
    "configurations": [
        {
            "name": "RTL_JOB_1",
            "rtl_job": "rtl/1.job",
            "elf": "firmware/1.elf",
            "enabled": true
        },
        {
            "name": "RTL_JOB_2",
            "rtl_job": "rtl/2.job",
            "elf": "firmware/2.elf",
            "enabled": true
        },
        {
            "name": "RTL_JOB_3",
            "rtl_job": "rtl/3.job",
            "elf": "firmware/3.elf",
            "enabled": true
        }
    ],
    "print_log_after_each_config": true
}